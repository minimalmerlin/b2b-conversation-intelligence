{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Labels",
  "type": "object",
  "required": [
    "topic_gt",
    "objections_gt",
    "outcome_gt"
  ],
  "properties": {
    "topic_gt": {
      "type": "string",
      "enum": [
        "integration",
        "pricing",
        "security",
        "rollout",
        "sla",
        "onboarding",
        "reporting",
        "api",
        "data_migration",
        "procurement",
        "compliance",
        "training",
        "customization",
        "support_process",
        "analytics"
      ]
    },
    "objections_gt": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "price",
          "timing",
          "competitor",
          "trust",
          "compliance",
          "resources",
          "feature_gap",
          "risk",
          "internal_buy_in",
          "legal_procurement"
        ]
      }
    },
    "outcome_gt": {
      "type": "string",
      "enum": [
        "next_step_scheduled",
        "resolved",
        "escalated",
        "won",
        "lost",
        "no_decision"
      ]
    }
  },
  "additionalProperties": false
}
