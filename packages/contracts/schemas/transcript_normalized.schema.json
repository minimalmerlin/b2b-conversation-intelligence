{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TranscriptNormalized",
  "type": "object",
  "required": [
    "transcript_id",
    "run_id",
    "created_at",
    "provider",
    "channel",
    "stage",
    "segment",
    "topics",
    "objections",
    "account_domain",
    "customer_email",
    "agent_email",
    "language",
    "transcript_text",
    "word_count"
  ],
  "properties": {
    "transcript_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "type": "string",
      "enum": ["dummy", "gemini"]
    },
    "channel": {
      "type": "string",
      "enum": ["sales", "support"]
    },
    "stage": {
      "type": "string",
      "enum": ["discovery", "qualification", "closing", "onboarding", "after_sales", "support"]
    },
    "segment": {
      "type": "string",
      "enum": ["smb", "midmarket", "enterprise", "agency"]
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "integration",
          "pricing",
          "security",
          "rollout",
          "sla",
          "onboarding",
          "reporting",
          "api",
          "data_migration",
          "procurement",
          "compliance",
          "training",
          "customization",
          "support_process",
          "analytics"
        ]
      }
    },
    "objections": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "price",
          "timing",
          "competitor",
          "trust",
          "compliance",
          "resources",
          "feature_gap",
          "risk",
          "internal_buy_in",
          "legal_procurement"
        ]
      }
    },
    "account_domain": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.example$"
    },
    "customer_email": {
      "type": "string",
      "format": "email"
    },
    "agent_email": {
      "type": "string",
      "format": "email"
    },
    "language": {
      "type": "string",
      "const": "en"
    },
    "transcript_text": {
      "type": "string",
      "minLength": 1000,
      "pattern": "Customer:"
    },
    "word_count": {
      "type": "integer",
      "minimum": 250,
      "maximum": 600
    }
  },
  "additionalProperties": false
}

