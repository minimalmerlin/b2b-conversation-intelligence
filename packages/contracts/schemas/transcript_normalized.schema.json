{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TranscriptNormalized",
  "type": "object",
  "required": [
    "conversation_id",
    "channel",
    "stage",
    "segment",
    "product",
    "account_domain",
    "participant_email",
    "transcript_text",
    "created_at",
    "labels"
  ],
  "properties": {
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "enum": [
        "dummy",
        "gemini"
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "sales",
        "support"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "discovery",
        "qualification",
        "closing",
        "onboarding",
        "after_sales",
        "support"
      ]
    },
    "segment": {
      "type": "string",
      "enum": [
        "smb",
        "midmarket",
        "enterprise",
        "agency"
      ]
    },
    "product": {
      "type": "string",
      "minLength": 3
    },
    "account_domain": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.[a-z0-9.-]+$"
    },
    "participant_email": {
      "type": "string",
      "format": "email"
    },
    "transcript_text": {
      "type": "string",
      "minLength": 1000,
      "allOf": [
        {
          "pattern": "Customer:"
        },
        {
          "pattern": "Agent:"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "word_count": {
      "type": "integer",
      "minimum": 250,
      "maximum": 600
    },
    "labels": {
      "type": "object",
      "required": [
        "topic_gt",
        "objections_gt",
        "outcome_gt"
      ],
      "properties": {
        "topic_gt": {
          "type": "string",
          "enum": [
            "integration",
            "pricing",
            "security",
            "rollout",
            "sla",
            "onboarding",
            "reporting",
            "api",
            "data_migration",
            "procurement",
            "compliance",
            "training",
            "customization",
            "support_process",
            "analytics"
          ]
        },
        "objections_gt": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "price",
              "timing",
              "competitor",
              "trust",
              "compliance",
              "resources",
              "feature_gap",
              "risk",
              "internal_buy_in",
              "legal_procurement"
            ]
          }
        },
        "outcome_gt": {
          "type": "string",
          "enum": [
            "next_step_scheduled",
            "resolved",
            "escalated",
            "won",
            "lost",
            "no_decision"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
