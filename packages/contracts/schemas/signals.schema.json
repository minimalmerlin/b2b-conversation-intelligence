{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Signals",
  "type": "object",
  "required": [
    "transcript_id",
    "channel",
    "stage",
    "segment",
    "topics",
    "objections",
    "summary",
    "sentiment_score",
    "urgency_score",
    "risk_level",
    "follow_up_actions"
  ],
  "properties": {
    "transcript_id": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "enum": ["sales", "support"]
    },
    "stage": {
      "type": "string",
      "enum": ["discovery", "qualification", "closing", "onboarding", "after_sales", "support"]
    },
    "segment": {
      "type": "string",
      "enum": ["smb", "midmarket", "enterprise", "agency"]
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "integration",
          "pricing",
          "security",
          "rollout",
          "sla",
          "onboarding",
          "reporting",
          "api",
          "data_migration",
          "procurement",
          "compliance",
          "training",
          "customization",
          "support_process",
          "analytics"
        ]
      }
    },
    "objections": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "price",
          "timing",
          "competitor",
          "trust",
          "compliance",
          "resources",
          "feature_gap",
          "risk",
          "internal_buy_in",
          "legal_procurement"
        ]
      }
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "sentiment_score": {
      "type": "number",
      "minimum": -1.0,
      "maximum": 1.0
    },
    "urgency_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "follow_up_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    }
  },
  "additionalProperties": false
}

