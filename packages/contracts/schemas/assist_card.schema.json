{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AssistCard",
  "type": "object",
  "required": [
    "transcript_id",
    "channel",
    "stage",
    "segment",
    "topics",
    "objections",
    "headline",
    "talk_track",
    "key_questions",
    "do_not_say",
    "next_step"
  ],
  "properties": {
    "transcript_id": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "enum": ["sales", "support"]
    },
    "stage": {
      "type": "string",
      "enum": ["discovery", "qualification", "closing", "onboarding", "after_sales", "support"]
    },
    "segment": {
      "type": "string",
      "enum": ["smb", "midmarket", "enterprise", "agency"]
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "integration",
          "pricing",
          "security",
          "rollout",
          "sla",
          "onboarding",
          "reporting",
          "api",
          "data_migration",
          "procurement",
          "compliance",
          "training",
          "customization",
          "support_process",
          "analytics"
        ]
      }
    },
    "objections": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "price",
          "timing",
          "competitor",
          "trust",
          "compliance",
          "resources",
          "feature_gap",
          "risk",
          "internal_buy_in",
          "legal_procurement"
        ]
      }
    },
    "headline": {
      "type": "string",
      "minLength": 10
    },
    "talk_track": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "key_questions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "do_not_say": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "next_step": {
      "type": "string",
      "minLength": 10
    }
  },
  "additionalProperties": false
}

