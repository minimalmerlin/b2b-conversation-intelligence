{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AssistCard",
  "type": "object",
  "required": [
    "conversation_id",
    "channel",
    "stage",
    "segment",
    "topic_pred",
    "objections_pred",
    "summary",
    "next_best_step",
    "followup_email_draft",
    "guardrails_passed"
  ],
  "properties": {
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "enum": ["sales", "support"]
    },
    "stage": {
      "type": "string",
      "enum": ["discovery", "qualification", "closing", "onboarding", "after_sales", "support"]
    },
    "segment": {
      "type": "string",
      "enum": ["smb", "midmarket", "enterprise", "agency"]
    },
    "topic_pred": {
      "type": "string",
      "enum": [
        "integration",
        "pricing",
        "security",
        "rollout",
        "sla",
        "onboarding",
        "reporting",
        "api",
        "data_migration",
        "procurement",
        "compliance",
        "training",
        "customization",
        "support_process",
        "analytics"
      ]
    },
    "objections_pred": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "price",
          "timing",
          "competitor",
          "trust",
          "compliance",
          "resources",
          "feature_gap",
          "risk",
          "internal_buy_in",
          "legal_procurement"
        ]
      }
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "next_best_step": {
      "type": "string",
      "minLength": 10
    },
    "followup_email_draft": {
      "type": "string",
      "minLength": 10
    },
    "guardrails_passed": {
      "type": "boolean"
    },
    "guardrail_violations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "additionalProperties": false
}
