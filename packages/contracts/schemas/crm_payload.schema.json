{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CrmPayload",
  "type": "object",
  "required": [
    "conversation_id",
    "target_crm",
    "identity",
    "actions"
  ],
  "properties": {
    "conversation_id": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "enum": ["sales", "support"]
    },
    "stage": {
      "type": "string",
      "enum": ["discovery", "qualification", "closing", "onboarding", "after_sales", "support"]
    },
    "segment": {
      "type": "string",
      "enum": ["smb", "midmarket", "enterprise", "agency"]
    },
    "topic_pred": {
      "type": "string",
      "enum": [
        "integration",
        "pricing",
        "security",
        "rollout",
        "sla",
        "onboarding",
        "reporting",
        "api",
        "data_migration",
        "procurement",
        "compliance",
        "training",
        "customization",
        "support_process",
        "analytics"
      ]
    },
    "objections_pred": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "price",
          "timing",
          "competitor",
          "trust",
          "compliance",
          "resources",
          "feature_gap",
          "risk",
          "internal_buy_in",
          "legal_procurement"
        ]
      }
    },
    "target_crm": {
      "type": "string",
      "enum": ["webhook", "hubspot", "salesforce", "dynamics365"]
    },
    "identity": {
      "type": "object",
      "required": ["participant_email", "account_domain"],
      "properties": {
        "participant_email": {
          "type": "string",
          "format": "email"
        },
        "account_domain": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.[a-z0-9.-]+$"
        }
      },
      "additionalProperties": false
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "body"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["create_note", "create_task", "create_email_draft"]
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "subject": {
            "type": "string",
            "minLength": 3
          },
          "body": {
            "type": "string",
            "minLength": 10
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
