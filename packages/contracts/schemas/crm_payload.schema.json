{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CrmPayload",
  "type": "object",
  "required": [
    "transcript_id",
    "channel",
    "stage",
    "segment",
    "topics",
    "objections",
    "account_domain",
    "contact_email",
    "status",
    "estimated_arr",
    "close_probability",
    "owner_alias",
    "next_step"
  ],
  "properties": {
    "transcript_id": {
      "type": "string",
      "minLength": 1
    },
    "channel": {
      "type": "string",
      "enum": ["sales", "support"]
    },
    "stage": {
      "type": "string",
      "enum": ["discovery", "qualification", "closing", "onboarding", "after_sales", "support"]
    },
    "segment": {
      "type": "string",
      "enum": ["smb", "midmarket", "enterprise", "agency"]
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "integration",
          "pricing",
          "security",
          "rollout",
          "sla",
          "onboarding",
          "reporting",
          "api",
          "data_migration",
          "procurement",
          "compliance",
          "training",
          "customization",
          "support_process",
          "analytics"
        ]
      }
    },
    "objections": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "price",
          "timing",
          "competitor",
          "trust",
          "compliance",
          "resources",
          "feature_gap",
          "risk",
          "internal_buy_in",
          "legal_procurement"
        ]
      }
    },
    "account_domain": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.example$"
    },
    "contact_email": {
      "type": "string",
      "format": "email"
    },
    "status": {
      "type": "string",
      "enum": ["open", "won", "lost", "on_hold"]
    },
    "estimated_arr": {
      "type": "number",
      "minimum": 0
    },
    "close_probability": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "owner_alias": {
      "type": "string",
      "pattern": "^agent_[0-9]{3}$"
    },
    "next_step": {
      "type": "string",
      "minLength": 10
    }
  },
  "additionalProperties": false
}
